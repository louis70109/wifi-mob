<Window x:Class="WiFiCat.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WiFiCat"
        Width="310"
        Height="390"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="True"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded"
        Closed="Window_Closed">
    <Border Padding="14"
            Background="#EF151D2B"
            BorderBrush="#FF48546A"
            BorderThickness="1"
            CornerRadius="14">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="32" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" MouseLeftButtonDown="DragHandle_MouseLeftButtonDown">
                <TextBlock Text="WiFiCat"
                           VerticalAlignment="Center"
                           FontFamily="Consolas"
                           FontSize="15"
                           FontWeight="Bold"
                           Foreground="#FFF2F4F8" />
                <Button Content="×"
                        Width="28"
                        Height="26"
                        Padding="0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Foreground="#FFE7EAF0"
                        Background="#332D3748"
                        BorderThickness="0"
                        Click="CloseButton_Click" />
            </Grid>

            <Image x:Name="MobImage"
                   Grid.Row="1"
                   Width="190"
                   Height="190"
                   Margin="0,6,0,10"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Stretch="Uniform"
                   SnapsToDevicePixels="True"
                   RenderOptions.BitmapScalingMode="NearestNeighbor" />

            <StackPanel Grid.Row="2" Orientation="Vertical">
                <TextBlock x:Name="SignalText"
                           Text="正在讀取 Wi-Fi 訊號…"
                           Margin="0,0,0,6"
                           FontFamily="Consolas"
                           FontSize="13"
                           Foreground="#FFF2F4F8" />
                <ProgressBar x:Name="SignalBar"
                             Minimum="0"
                             Maximum="100"
                             Height="9"
                             Margin="0,0,0,12"
                             Foreground="#FF58C878"
                             Background="#FF303A49" />
                <ComboBox x:Name="MobSelector"
                          Height="32"
                          DisplayMemberPath="Name"
                          SelectionChanged="MobSelector_SelectionChanged" />
                <TextBlock x:Name="MobHint"
                           Text="楓之谷原圖首次載入需網路，之後會快取"
                           Margin="0,7,0,0"
                           TextWrapping="Wrap"
                           FontSize="11"
                           Foreground="#FFB8C0CC" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
